{{- /* Hugo's built-in feed only has summaries, this one has the full content */ -}}
{{- $pctx := . -}}
{{- if .IsHome -}}{{ $pctx = .Site }}{{- end -}}
{{- $pages := slice -}}
{{- if or .IsHome .IsSection -}}
{{- $pages = $pctx.RegularPages -}}
{{- else -}}
{{- $pages = $pctx.Pages -}}
{{- end -}}
{{- $limit := .Site.Config.Services.RSS.Limit -}}
{{- if ge $limit 1 -}}
{{- $pages = $pages | first $limit -}}
{{- end -}}
{{- /* Feed readers have no page to resolve relative links against */ -}}
{{- $siteRefs := `(href|src)="(/(?:[^/"][^"]*)?")` -}}
{{- $pageRefs := `(href|src)="(?:\./|(#))` -}}
{{- $site := printf `${1}="%s${2}` (strings.TrimSuffix "/" .Site.BaseURL) -}}
{{- printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
  <channel>
    <title>{{ if eq .Title .Site.Title }}{{ .Site.Title }}{{ else }}{{ with .Title }}{{ . }} on {{ end }}{{ .Site.Title }}{{ end }}</title>
    <link>{{ .Permalink }}</link>
    <description>Recent content {{ if ne .Title .Site.Title }}{{ with .Title }}in {{ . }} {{ end }}{{ end }}on {{ .Site.Title }}</description>
    <generator>Hugo -- gohugo.io</generator>
    <language>{{ .Site.Language.Locale }}</language>
    {{- with .Site.Copyright }}
    <copyright>{{ . }}</copyright>
    {{- end }}
    {{- if not .Date.IsZero }}
    <lastBuildDate>{{ .Date.Format "Mon, 02 Jan 2006 15:04:05 -0700" | safeHTML }}</lastBuildDate>
    {{- end }}
    {{- with .OutputFormats.Get "RSS" }}
    {{ printf "<atom:link href=%q rel=\"self\" type=%q />" .Permalink .MediaType | safeHTML }}
    {{- end }}
    {{- range $pages }}
    {{- $page := printf `${1}="%s${2}` .Permalink }}
    <item>
      <title>{{ .Title }}</title>
      <link>{{ .Permalink }}</link>
      <pubDate>{{ .Date.Format "Mon, 02 Jan 2006 15:04:05 -0700" | safeHTML }}</pubDate>
      {{- /* Not the permalink, so that changing baseurl does not resend every post */}}
      <guid isPermaLink="false">{{ .RelPermalink }}</guid>
      <description>{{ .Summary | replaceRE $siteRefs $site | replaceRE $pageRefs $page | html }}</description>
      <content>{{ .Content | replaceRE $siteRefs $site | replaceRE $pageRefs $page | html }}</content>
    </item>
    {{- end }}
  </channel>
</rss>
